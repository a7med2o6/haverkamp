# ── Database ──────────────────────────────────────────────
POSTGRES_USER=haverkamp
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=haverkamp
POSTGRES_PORT=5432
DATABASE_URL="postgresql://haverkamp:change_me_in_production@localhost:5432/haverkamp?schema=public"

# ── Auth.js ───────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# ── Site ──────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://haverkampkw.com
NEXT_PUBLIC_WHATSAPP=96551111154

# ── Uploads ───────────────────────────────────────────────
# Local disk path for uploaded media (mounted volume in production)
UPLOAD_DIR=./public/uploads

# ── تذكير الحجوزات عبر واتساب ─────────────────────────────
# اتركها فارغة ليبقى الإرسال يدوياً من طابور «التذكيرات» في اللوحة
# (رابط wa.me برسالة جاهزة). املأها ليُرسل التذكير تلقائياً.
#
# من WhatsApp Cloud API في Meta for Developers:
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# اسم قالب الرسالة المعتمد من Meta — لازم لبدء محادثة خارج نافذة الـ24 ساعة.
# متن القالب: {{1}} اسم العميل، {{2}} الخدمة، {{3}} الموعد.
# زرّ الرابط الديناميكي: https://haverkampkw.com/b/{{1}}
# إن تُرك فارغاً تُرسل رسالة نصية حرّة (لا تصل إلا داخل نافذة الـ24 ساعة).
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=ar

# سرّ المهمة المجدولة التي تستدعي /api/cron/reminders يومياً.
# بدونه يُرفض المسار — مسار مفتوح يستنزف رصيد الرسائل.
# Generate with: openssl rand -base64 32
CRON_SECRET=
