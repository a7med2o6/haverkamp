// Haverkamp Kuwait — منصة إدارة متكاملة
// Prisma 7 · PostgreSQL
// العملة: الدينار الكويتي (3 خانات عشرية / فلس)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ═══════════════════════════════════════════════════════════
//  المصادقة والصلاحيات · AUTH & RBAC
// ═══════════════════════════════════════════════════════════

enum Role {
  OWNER // المالك — كل الصلاحيات
  ADMIN // مدير النظام
  MANAGER // مدير الفرع
  HR // موارد بشرية
  ACCOUNTANT // محاسب
  CASHIER // كاشير / نقطة بيع
  TECHNICIAN // فني
  RECEPTIONIST // استقبال
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  phone        String?
  image        String?
  role         Role      @default(RECEPTIONIST)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  employee         Employee?
  auditLogs        AuditLog[]
  stockMovements   StockMovement[]
  ordersAsCashier  Order[]           @relation("OrderCashier")
  registerSessions RegisterSession[]
  approvedLeaves   LeaveRequest[]    @relation("LeaveApprover")
  reviewsGiven     PerformanceReview[] @relation("ReviewAuthor")

  @@index([role, isActive])
  @@map("users")
}

model AuditLog {
  id       String   @id @default(cuid())
  userId   String?
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action   String // CREATE | UPDATE | DELETE | LOGIN | ...
  entity   String // اسم الجدول
  entityId String?
  changes  Json?
  ip       String?
  at       DateTime @default(now())

  @@index([entity, entityId])
  @@index([userId, at])
  @@map("audit_logs")
}

// ═══════════════════════════════════════════════════════════
//  إدارة المحتوى · CMS
// ═══════════════════════════════════════════════════════════

enum Locale {
  ar
  en
}

model Service {
  id        String   @id @default(cuid())
  slug      String   @unique // protication, tint, paint, glass, polish, wash ...
  icon      String? // اسم أيقونة lucide
  heroImage String?
  cardImage String?
  color     String? // لون مميز للبطاقة
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  showInNav Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations ServiceTranslation[]
  packages     ServicePackage[]
  gallery      GalleryItem[]
  bookings     Booking[]
  products     Product[]
  jobItems     JobOrderItem[]
  warranties   Warranty[]

  @@index([isActive, sortOrder])
  @@map("services")
}

model ServiceTranslation {
  id              String  @id @default(cuid())
  serviceId       String
  service         Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  locale          Locale
  name            String
  tagline         String?
  shortDesc       String?
  longDesc        String? // Markdown
  metaTitle       String?
  metaDescription String?
  keywords        String?

  @@unique([serviceId, locale])
  @@map("service_translations")
}

model ServicePackage {
  id        String  @id @default(cuid())
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  price     Decimal @db.Decimal(12, 3)
  priceFrom Boolean @default(true) // "يبدأ من"
  duration  String? // مثال: "٣ أيام"
  warranty  String? // مثال: "١٠ سنوات"
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)
  isPopular Boolean @default(false)

  translations ServicePackageTranslation[]

  @@index([serviceId, sortOrder])
  @@map("service_packages")
}

model ServicePackageTranslation {
  id        String         @id @default(cuid())
  packageId String
  package   ServicePackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  locale    Locale
  name      String
  features  String[] // قائمة المميزات

  @@unique([packageId, locale])
  @@map("service_package_translations")
}

model GalleryItem {
  id          String   @id @default(cuid())
  serviceId   String?
  service     Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  imageUrl    String
  beforeUrl   String? // للمقارنة قبل/بعد
  afterUrl    String?
  captionAr   String?
  captionEn   String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  isFeatured  Boolean  @default(false) // يظهر بالصفحة الرئيسية
  createdAt   DateTime @default(now())

  @@index([serviceId, isActive, sortOrder])
  @@map("gallery_items")
}

model Testimonial {
  id        String   @id @default(cuid())
  author    String
  avatar    String?
  rating    Int      @default(5)
  bodyAr    String
  bodyEn    String?
  carModel  String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([isActive, sortOrder])
  @@map("testimonials")
}

model Faq {
  id        String  @id @default(cuid())
  questionAr String
  answerAr   String
  questionEn String?
  answerEn   String?
  serviceSlug String? // مرتبط بخدمة معينة أو عام
  sortOrder  Int     @default(0)
  isActive   Boolean @default(true)

  @@index([serviceSlug, isActive, sortOrder])
  @@map("faqs")
}

/// صفحات ثابتة (البنود والشروط، سياسة الخصوصية ...)
model Page {
  id        String   @id @default(cuid())
  slug      String   @unique
  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt

  translations PageTranslation[]

  @@map("pages")
}

model PageTranslation {
  id              String @id @default(cuid())
  pageId          String
  page            Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  locale          Locale
  title           String
  body            String // Markdown
  metaTitle       String?
  metaDescription String?

  @@unique([pageId, locale])
  @@map("page_translations")
}

/// مفاتيح الترجمة العامة (بديل js/i18n.js)
model Translation {
  id        String   @id @default(cuid())
  key       String   @unique
  ar        String
  en        String?
  group     String   @default("common") // nav, hero, footer ...
  updatedAt DateTime @updatedAt

  @@index([group])
  @@map("translations")
}

/// إعدادات الموقع (أرقام التواصل، السوشيال، بكسلات التتبع ...)
model SiteSetting {
  key       String   @id
  value     Json
  group     String   @default("general")
  updatedAt DateTime @updatedAt

  @@index([group])
  @@map("site_settings")
}

// ═══════════════════════════════════════════════════════════
//  العملاء والحجوزات · CRM
// ═══════════════════════════════════════════════════════════

enum CustomerSource {
  WALK_IN
  WEBSITE
  WHATSAPP
  INSTAGRAM
  REFERRAL
  GOOGLE_ADS
  OTHER
}

model Customer {
  id        String         @id @default(cuid())
  code      String         @unique // HK-C-0001
  name      String
  phone     String
  altPhone  String?
  email     String?
  civilId   String?
  address   String?
  area      String? // المنطقة
  notes     String?
  source    CustomerSource @default(WALK_IN)
  isBlocked Boolean        @default(false)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  vehicles  Vehicle[]
  bookings  Booking[]
  jobOrders JobOrder[]
  orders    Order[]

  @@index([phone])
  @@index([name])
  @@map("customers")
}

model Vehicle {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  make       String // الماركة
  model      String
  year       Int?
  color      String?
  plateNo    String?
  vin        String?
  notes      String?
  createdAt  DateTime @default(now())

  bookings   Booking[]
  jobOrders  JobOrder[]
  warranties Warranty[]

  @@index([customerId])
  @@index([plateNo])
  @@map("vehicles")
}

enum BookingStatus {
  PENDING // بانتظار التأكيد
  CONFIRMED // مؤكد
  IN_PROGRESS // قيد التنفيذ
  COMPLETED // منتهي
  CANCELLED // ملغي
  NO_SHOW // لم يحضر
}

model Booking {
  id          String        @id @default(cuid())
  code        String        @unique // HK-B-0001
  customerId  String?
  customer    Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  vehicleId   String?
  vehicle     Vehicle?      @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  serviceId   String?
  service     Service?      @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  // بيانات مُدخلة من نموذج الموقع قبل إنشاء ملف عميل
  guestName   String?
  guestPhone  String?
  guestCar    String?
  scheduledAt DateTime
  status      BookingStatus @default(PENDING)
  notes       String?
  source      CustomerSource @default(WEBSITE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  jobOrder JobOrder?

  @@index([status, scheduledAt])
  @@index([scheduledAt])
  @@map("bookings")
}

model Warranty {
  id            String   @id @default(cuid())
  certificateNo String   @unique // HK-W-0001
  vehicleId     String
  vehicle       Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  serviceId     String?
  service       Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  jobOrderId    String?
  jobOrder      JobOrder? @relation(fields: [jobOrderId], references: [id], onDelete: SetNull)
  startDate     DateTime
  endDate       DateTime
  terms         String?
  isVoid        Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([endDate])
  @@index([vehicleId])
  @@map("warranties")
}

// ═══════════════════════════════════════════════════════════
//  الموارد البشرية · HR
// ═══════════════════════════════════════════════════════════

model Department {
  id        String     @id @default(cuid())
  nameAr    String
  nameEn    String?
  managerId String?
  employees Employee[]

  @@map("departments")
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  TERMINATED
}

model Employee {
  id           String         @id @default(cuid())
  code         String         @unique // HK-E-001
  userId       String?        @unique
  user         User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  fullName     String
  fullNameEn   String?
  position     String
  departmentId String?
  department   Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  phone        String
  email        String?
  nationality  String?
  civilId      String?
  photo        String?
  birthDate    DateTime?
  hireDate     DateTime
  contractEnd  DateTime?
  sponsor      String? // الكفيل — الجهة التي تحمل الإقامة
  status       EmployeeStatus @default(ACTIVE)
  baseSalary   Decimal        @db.Decimal(12, 3)
  allowance    Decimal        @default(0) @db.Decimal(12, 3)
  bankName     String? // اسم البنك (KIB، NBK …)
  bankAccount  String? // رقم الحساب
  bankIban     String?
  emergencyContact String?
  annualLeaveDays  Int        @default(30)
  notes        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  attendance   Attendance[]
  leaves       LeaveRequest[]
  payslips     Payslip[]
  documents    EmployeeDocument[]
  reviews      PerformanceReview[]
  jobOrders    JobOrderAssignee[]

  @@index([status])
  @@index([departmentId])
  @@map("employees")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  ON_LEAVE
  HOLIDAY
}

model Attendance {
  id         String           @id @default(cuid())
  employeeId String
  employee   Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       DateTime         @db.Date
  checkIn    DateTime?
  checkOut   DateTime?
  status     AttendanceStatus @default(PRESENT)
  lateMins   Int              @default(0)
  overtimeMins Int            @default(0)
  notes      String?
  createdAt  DateTime         @default(now())

  @@unique([employeeId, date])
  @@index([date])
  @@map("attendance")
}

enum LeaveType {
  ANNUAL // سنوية
  SICK // مرضية
  UNPAID // بدون راتب
  EMERGENCY // طارئة
  MATERNITY // أمومة
  HAJJ // حج
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model LeaveRequest {
  id         String      @id @default(cuid())
  employeeId String
  employee   Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type       LeaveType
  fromDate   DateTime    @db.Date
  toDate     DateTime    @db.Date
  days       Int
  reason     String?
  status     LeaveStatus @default(PENDING)
  approverId String?
  approver   User?       @relation("LeaveApprover", fields: [approverId], references: [id], onDelete: SetNull)
  decidedAt  DateTime?
  decisionNote String?
  createdAt  DateTime    @default(now())

  @@index([employeeId, status])
  @@index([status])
  @@map("leave_requests")
}

enum PayrollStatus {
  DRAFT
  APPROVED
  PAID
}

model PayrollRun {
  id          String        @id @default(cuid())
  month       Int // 1-12
  year        Int
  status      PayrollStatus @default(DRAFT)
  totalNet    Decimal       @default(0) @db.Decimal(14, 3)
  notes       String?
  processedAt DateTime?
  createdAt   DateTime      @default(now())

  payslips Payslip[]

  @@unique([month, year])
  @@map("payroll_runs")
}

model Payslip {
  id           String     @id @default(cuid())
  payrollRunId String
  payrollRun   PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employeeId   String
  employee     Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  baseSalary   Decimal    @db.Decimal(12, 3)
  allowances   Decimal    @default(0) @db.Decimal(12, 3)
  overtime     Decimal    @default(0) @db.Decimal(12, 3)
  deductions   Decimal    @default(0) @db.Decimal(12, 3)
  netPay       Decimal    @db.Decimal(12, 3)
  absentDays   Int        @default(0)
  notes        String?

  items PayslipItem[]

  @@unique([payrollRunId, employeeId])
  @@map("payslips")
}

enum PayslipItemType {
  EARNING
  DEDUCTION
}

model PayslipItem {
  id        String          @id @default(cuid())
  payslipId String
  payslip   Payslip         @relation(fields: [payslipId], references: [id], onDelete: Cascade)
  type      PayslipItemType
  label     String
  amount    Decimal         @db.Decimal(12, 3)

  @@map("payslip_items")
}

enum DocumentType {
  CIVIL_ID // البطاقة المدنية
  PASSPORT // الجواز
  WORK_PERMIT // إذن العمل
  RESIDENCY // الإقامة
  RESIDENCY_APPLICATION // طلب الإقامة
  CONTRACT // عقد العمل
  INSURANCE // التأمين
  LICENSE // رخصة قيادة
  HEALTH_CERT // شهادة صحية
  OTHER
}

model EmployeeDocument {
  id         String       @id @default(cuid())
  employeeId String
  employee   Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type       DocumentType
  number     String?
  issueDate  DateTime?
  expiryDate DateTime?
  fileUrl    String?
  notes      String?
  createdAt  DateTime     @default(now())

  @@index([expiryDate])
  @@index([employeeId])
  @@map("employee_documents")
}

model PerformanceReview {
  id           String   @id @default(cuid())
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  reviewerId   String?
  reviewer     User?    @relation("ReviewAuthor", fields: [reviewerId], references: [id], onDelete: SetNull)
  periodLabel  String // "Q1 2026"
  rating       Int // 1-5
  strengths    String?
  improvements String?
  goals        String?
  createdAt    DateTime @default(now())

  @@index([employeeId])
  @@map("performance_reviews")
}

// ═══════════════════════════════════════════════════════════
//  المخزون · INVENTORY
// ═══════════════════════════════════════════════════════════

model Supplier {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  country   String?
  address   String?
  notes     String?
  createdAt DateTime @default(now())

  purchaseOrders PurchaseOrder[]

  @@map("suppliers")
}

model ProductCategory {
  id        String    @id @default(cuid())
  nameAr    String
  nameEn    String?
  sortOrder Int       @default(0)
  products  Product[]

  @@map("product_categories")
}

enum ProductType {
  GOOD // منتج ملموس (إكسسوار، فيلم)
  SERVICE // خدمة تُباع بنقطة البيع
}

model Product {
  id           String           @id @default(cuid())
  sku          String           @unique
  barcode      String?          @unique
  nameAr       String
  nameEn       String?
  type         ProductType      @default(GOOD)
  categoryId   String?
  category     ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  serviceId    String? // مرتبط بخدمة (لعرضه بصفحة الخدمة)
  service      Service?         @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  description  String?
  image        String?
  unit         String           @default("قطعة")
  cost         Decimal          @default(0) @db.Decimal(12, 3)
  price        Decimal          @db.Decimal(12, 3)
  trackStock   Boolean          @default(true)
  stockQty     Decimal          @default(0) @db.Decimal(12, 2)
  reorderLevel Decimal          @default(0) @db.Decimal(12, 2)
  isActive     Boolean          @default(true)
  showOnline   Boolean          @default(false) // يظهر بمتجر الإكسسوارات
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  movements  StockMovement[]
  orderItems OrderItem[]
  poItems    PurchaseOrderItem[]
  jobItems   JobOrderItem[]

  @@index([isActive, categoryId])
  @@index([showOnline])
  @@map("products")
}

enum StockMovementType {
  IN // وارد
  OUT // صادر
  ADJUST // تسوية جرد
  RETURN // مرتجع
  DAMAGE // تالف
}

model StockMovement {
  id        String            @id @default(cuid())
  productId String
  product   Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  type      StockMovementType
  qty       Decimal           @db.Decimal(12, 2)
  balance   Decimal           @db.Decimal(12, 2) // الرصيد بعد الحركة
  unitCost  Decimal?          @db.Decimal(12, 3)
  reference String? // رقم الفاتورة / أمر الشراء
  note      String?
  userId    String?
  user      User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime          @default(now())

  @@index([productId, createdAt])
  @@map("stock_movements")
}

enum PurchaseStatus {
  DRAFT
  ORDERED
  PARTIAL
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id         String         @id @default(cuid())
  number     String         @unique // HK-PO-0001
  supplierId String?
  supplier   Supplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  status     PurchaseStatus @default(DRAFT)
  orderDate  DateTime       @default(now())
  expectedAt DateTime?
  receivedAt DateTime?
  subtotal   Decimal        @default(0) @db.Decimal(14, 3)
  shipping   Decimal        @default(0) @db.Decimal(12, 3)
  total      Decimal        @default(0) @db.Decimal(14, 3)
  notes      String?

  items PurchaseOrderItem[]

  @@index([status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  qty             Decimal       @db.Decimal(12, 2)
  receivedQty     Decimal       @default(0) @db.Decimal(12, 2)
  unitCost        Decimal       @db.Decimal(12, 3)
  total           Decimal       @db.Decimal(14, 3)

  @@map("purchase_order_items")
}

// ═══════════════════════════════════════════════════════════
//  أوامر الشغل · WORKSHOP JOB ORDERS
// ═══════════════════════════════════════════════════════════

enum JobStatus {
  RECEIVED // تم الاستلام
  IN_PROGRESS // قيد التنفيذ
  QUALITY_CHECK // فحص جودة
  READY // جاهز للتسليم
  DELIVERED // تم التسليم
  CANCELLED
}

model JobOrder {
  id          String    @id @default(cuid())
  number      String    @unique // HK-J-0001
  bookingId   String?   @unique
  booking     Booking?  @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  customerId  String
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  vehicleId   String?
  vehicle     Vehicle?  @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  status      JobStatus @default(RECEIVED)
  odometer    Int?
  receivedAt  DateTime  @default(now())
  promisedAt  DateTime?
  completedAt DateTime?
  deliveredAt DateTime?
  intakeNotes String? // ملاحظات الاستلام (خدوش موجودة ...)
  intakePhotos String[] // صور حالة السيارة عند الاستلام
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  items      JobOrderItem[]
  assignees  JobOrderAssignee[]
  warranties Warranty[]
  order      Order?

  @@index([status])
  @@index([customerId])
  @@map("job_orders")
}

model JobOrderItem {
  id         String   @id @default(cuid())
  jobOrderId String
  jobOrder   JobOrder @relation(fields: [jobOrderId], references: [id], onDelete: Cascade)
  serviceId  String?
  service    Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  productId  String?
  product    Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  label      String
  qty        Decimal  @default(1) @db.Decimal(12, 2)
  unitPrice  Decimal  @db.Decimal(12, 3)
  total      Decimal  @db.Decimal(14, 3)
  isDone     Boolean  @default(false)

  @@map("job_order_items")
}

model JobOrderAssignee {
  jobOrderId String
  jobOrder   JobOrder @relation(fields: [jobOrderId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@id([jobOrderId, employeeId])
  @@map("job_order_assignees")
}

// ═══════════════════════════════════════════════════════════
//  نقطة البيع والفواتير · POS & INVOICES
// ═══════════════════════════════════════════════════════════

enum OrderStatus {
  DRAFT // فاتورة معلّقة (parked)
  COMPLETED // مدفوعة بالكامل
  PARTIAL // مدفوعة جزئياً
  REFUNDED
  CANCELLED
}

enum OrderChannel {
  POS // نقطة بيع بالفرع
  INVOICE // فاتورة أمر شغل
  ONLINE
}

model Order {
  id                String       @id @default(cuid())
  number            String       @unique // HK-INV-0001
  channel           OrderChannel @default(POS)
  status            OrderStatus  @default(DRAFT)
  customerId        String?
  customer          Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  jobOrderId        String?      @unique
  jobOrder          JobOrder?    @relation(fields: [jobOrderId], references: [id], onDelete: SetNull)
  cashierId         String?
  cashier           User?        @relation("OrderCashier", fields: [cashierId], references: [id], onDelete: SetNull)
  registerSessionId String?
  registerSession   RegisterSession? @relation(fields: [registerSessionId], references: [id], onDelete: SetNull)

  subtotal       Decimal @default(0) @db.Decimal(14, 3)
  discountAmount Decimal @default(0) @db.Decimal(12, 3)
  discountNote   String?
  taxAmount      Decimal @default(0) @db.Decimal(12, 3)
  total          Decimal @default(0) @db.Decimal(14, 3)
  paidAmount     Decimal @default(0) @db.Decimal(14, 3)

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items    OrderItem[]
  payments Payment[]

  @@index([status, createdAt])
  @@index([channel, createdAt])
  @@map("orders")
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  label     String // نسخة من الاسم وقت البيع
  qty       Decimal  @default(1) @db.Decimal(12, 2)
  unitPrice Decimal  @db.Decimal(12, 3)
  discount  Decimal  @default(0) @db.Decimal(12, 3)
  total     Decimal  @db.Decimal(14, 3)

  @@index([orderId])
  @@map("order_items")
}

enum PaymentMethod {
  CASH // نقدي
  KNET // كي نت
  VISA // فيزا / ماستر
  TRANSFER // تحويل بنكي
  LINK // رابط دفع
  CREDIT // آجل
}

model Payment {
  id         String        @id @default(cuid())
  orderId    String
  order      Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method     PaymentMethod
  amount     Decimal       @db.Decimal(14, 3)
  reference  String? // رقم العملية
  receivedAt DateTime      @default(now())

  @@index([orderId])
  @@index([receivedAt])
  @@map("payments")
}

/// وردية الصندوق — فتح/إغلاق يومي
model RegisterSession {
  id           String    @id @default(cuid())
  openedById   String
  openedBy     User      @relation(fields: [openedById], references: [id], onDelete: Restrict)
  openedAt     DateTime  @default(now())
  openingFloat Decimal   @default(0) @db.Decimal(12, 3)
  closedAt     DateTime?
  closingCash  Decimal?  @db.Decimal(12, 3)
  expectedCash Decimal?  @db.Decimal(12, 3)
  variance     Decimal?  @db.Decimal(12, 3)
  notes        String?

  orders Order[]

  @@index([openedAt])
  @@map("register_sessions")
}

/// عدادات ترقيم المستندات (HK-INV-0001 ...)
model Counter {
  key   String @id // invoice, booking, customer, job ...
  value Int    @default(0)

  @@map("counters")
}
